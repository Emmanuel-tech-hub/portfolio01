    </div>
  </section>

  <footer>
    © 2025 Emmanuel Nyong  |  Built with n8n · Claude · GitHub Pages  |  <a href="mailto:reachmoredigital01@gmail.com" style="color:var(--accent)">reachmoredigital01@gmail.com</a>
  </footer>
</div>
</body>
</html>
